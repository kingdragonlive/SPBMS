            </div>
            <div id="transfer-form">
              <div class="form-grid form-grid-2">
                <div class="form-group">
                  <label>โครงการต้นทาง <span class="required">*</span></label>
                  <select class="form-control">
                    <option>--- เลือกโครงการ ---</option>
                    <option>PRJ-2568-001 — ค่ายวิชาการ</option>
                    <option>PRJ-2568-002 — พัฒนาครู ICT</option>
                    <option>PRJ-2568-003 — กีฬาสี</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>หมวดรายจ่ายต้นทาง <span class="required">*</span></label>
                  <select class="form-control">
                    <option>ค่าตอบแทน</option>
                    <option>ค่าใช้สอย</option>
                    <option>ค่าวัสดุ</option>
                    <option>ค่าครุภัณฑ์</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>โครงการปลายทาง <span class="required">*</span></label>
                  <select class="form-control">
                    <option>--- เลือกโครงการ ---</option>
                    <option>PRJ-2568-004 — โครงการเรียนรู้</option>
                    <option>PRJ-2568-005 — พัฒนาห้องสมุด</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>หมวดรายจ่ายปลายทาง <span class="required">*</span></label>
                  <select class="form-control">
                    <option>ค่าตอบแทน</option>
                    <option>ค่าใช้สอย</option>
                    <option>ค่าวัสดุ</option>
                    <option>ค่าครุภัณฑ์</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>จำนวนเงินที่โอน (บาท) <span class="required">*</span></label>
                  <input type="number" class="form-control" placeholder="0.00">
                </div>
                <div class="form-group">
                  <label>เหตุผล <span class="required">*</span></label>
