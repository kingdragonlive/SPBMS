</div><!-- /app -->

<!-- ===== MODALS ===== -->

<!-- NEW PROJECT MODAL -->
<div class="modal-overlay" id="modal-new-project">
  <div class="modal" style="max-width:800px;">
    <div class="modal-header">
      <h2>📋 สร้างโครงการใหม่</h2>
      <button class="btn-icon" onclick="closeModal('modal-new-project')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-grid form-grid-2">
          <div class="form-group">
            <label>ชื่อโครงการ <span class="required">*</span></label>
            <input type="text" id="pj-name" class="form-control" placeholder="กรอกชื่อโครงการ">
          </div>
          <div class="form-group">
            <label>ฝ่าย/งาน <span class="required">*</span></label>
            <select id="pj-dept" class="form-control">
              <option>วิชาการ</option>
              <option>กิจการนักเรียน</option>
              <option>งบประมาณ</option>
              <option>บุคคล</option>
              <option>ทั่วไป</option>
            </select>
          </div>
          <div class="form-group">
            <label>ประเภทโครงการ</label>
            <select class="form-control">
              <option>พัฒนาผู้เรียน</option>
              <option>พัฒนาครู</option>
              <option>บริหารจัดการ</option>
              <option>ชุมชนสัมพันธ์</option>
              <option>บูรณาการ</option>
            </select>
          </div>
          <div class="form-group">
            <label>แหล่งงบประมาณ <span class="required">*</span></label>
            <select id="pj-source" class="form-control">
              <option>งบรัฐบาล</option>
              <option>เงินบำรุงการศึกษา</option>
              <option>เงินบริจาค</option>
              <option>อื่นๆ</option>
            </select>
          </div>
          <div class="form-group">
            <label>วันเริ่มต้น <span class="required">*</span></label>
            <input type="date" id="pj-start" class="form-control" value="2024-11-01">
          </div>
          <div class="form-group">
            <label>วันสิ้นสุด <span class="required">*</span></label>
            <input type="date" id="pj-end" class="form-control" value="2025-01-31">
          </div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;">
          <div class="form-group">
            <label>ค่าตอบแทน</label>
            <input type="number" id="pj-c1" class="form-control" placeholder="0" oninput="calcTotal()">
          </div>
          <div class="form-group">
            <label>ค่าใช้สอย</label>
            <input type="number" id="pj-c2" class="form-control" placeholder="0" oninput="calcTotal()">
          </div>
          <div class="form-group">
            <label>ค่าวัสดุ</label>
            <input type="number" id="pj-c3" class="form-control" placeholder="0" oninput="calcTotal()">
          </div>
          <div class="form-group">
            <label>ค่าครุภัณฑ์</label>
            <input type="number" id="pj-c4" class="form-control" placeholder="0" oninput="calcTotal()">
          </div>
        </div>

        <div style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px;display:flex;justify-content:space-between;align-items:center;">
          <span style="font-size:14px;color:var(--text2);">งบประมาณรวมที่ขอ</span>
          <span id="pj-total" style="font-size:20px;font-weight:800;color:var(--accent3);">0 บาท</span>
        </div>

        <div class="form-group">
          <label>วัตถุประสงค์และรายละเอียด <span class="required">*</span></label>
          <textarea id="pj-desc" class="form-control" rows="3" placeholder="อธิบายโครงการโดยละเอียด..."></textarea>
        </div>

        <div class="form-group">
          <label>ตัวชี้วัด (KPI)</label>
          <div style="display:grid;grid-template-columns:1fr auto auto;gap:8px;">
            <input type="text" class="form-control" placeholder="ชื่อตัวชี้วัด เช่น จำนวนผู้เข้าร่วม">
            <input type="number" class="form-control" placeholder="เป้าหมาย" style="width:100px;">
            <input type="text" class="form-control" placeholder="หน่วย" style="width:80px;">
          </div>
        </div>

        <!-- Priority Score -->
        <div style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px;">
          <div style="font-size:13px;font-weight:700;color:var(--accent2);margin-bottom:12px;">⭐ Priority Score (คำนวณอัตโนมัติ)</div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
            <div class="form-group">
              <label>ความเร่งด่วน (1-5)</label>
              <input type="range" min="1" max="5" value="3" class="form-control" style="padding:4px;" oninput="calcPriority(this,'urgency')">
              <div style="text-align:center;font-size:13px;font-weight:700;color:var(--accent3);" id="urgency-val">3</div>
            </div>
            <div class="form-group">
              <label>ผลกระทบ (1-5)</label>
              <input type="range" min="1" max="5" value="3" class="form-control" style="padding:4px;" oninput="calcPriority(this,'impact')">
              <div style="text-align:center;font-size:13px;font-weight:700;color:var(--accent3);" id="impact-val">3</div>
            </div>
            <div class="form-group">
              <label>สอดคล้องยุทธศาสตร์</label>
              <input type="range" min="1" max="5" value="3" class="form-control" style="padding:4px;" oninput="calcPriority(this,'strategic')">
              <div style="text-align:center;font-size:13px;font-weight:700;color:var(--accent3);" id="strategic-val">3</div>
            </div>
          </div>
          <div style="text-align:center;margin-top:8px;">
            <span style="font-size:13px;color:var(--text3);">Priority Score: </span>
            <span id="priority-score" style="font-size:22px;font-weight:800;color:var(--accent);">27</span>
            <span style="font-size:13px;color:var(--text3);">/125</span>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="saveProjectDraft()">💾 บันทึกร่าง</button>
      <button class="btn btn-primary" onclick="submitProject()">📤 ส่งเสนอโครงการ</button>
    </div>
  </div>
</div>

<!-- APPROVAL MODAL -->
