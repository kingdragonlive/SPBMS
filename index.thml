    { id:'TRF-2568-002', from:'งบกลาง', to:'PRJ-2568-003', amount:20000, reason:'งบเพิ่มเติมกีฬาสี', status:'pending', date:'2024-11-25' },
  ]
};

// State
let currentPage = 'dashboard';
let priorityScores = { urgency:3, impact:3, strategic:3 };

// ===== NAVIGATION =====
function goto(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));

  const pg = document.getElementById('page-' + page);
  if (pg) pg.classList.add('active');

  document.querySelectorAll('.nav-item').forEach(n => {
    if (n.getAttribute('onclick') && n.getAttribute('onclick').includes("'" + page + "'")) {
      n.classList.add('active');
    }
  });

  const titles = {
    dashboard: '📊 หน้าหลัก — ภาพรวมระบบ',
    projects: '📋 โครงการทั้งหมด',
    approval: '✅ รออนุมัติ',
    budget: '💰 ภาพรวมงบประมาณ',
    payment: '🧾 ขอเบิกเงิน',
    transfer: '🔄 โยกย้ายงบประมาณ',
    activity: '📅 ติดตามกิจกรรม',
    procurement: '🛒 พัสดุและตรวจรับ',
    amendment: '📝 การเปลี่ยนแปลง',
    reports: '📄 ออกรายงาน',
    yearend: '🔒 ปิดปีงบประมาณ',
    notifications: '🔔 ศูนย์แจ้งเตือน',
    settings: '⚙️ ตั้งค่าระบบ',
  };
  document.getElementById('page-title').textContent = titles[page] || page;
  currentPage = page;
  renderPage(page);
}

function setTab(page, tab, el) {
  el.closest('.tab-bar').querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

// ===== RENDER FUNCTIONS =====
function renderPage(page) {
  if (page === 'dashboard') renderDashboard();
  if (page === 'projects')  renderProjects();
  if (page === 'approval')  renderApprovals();
  if (page === 'budget')    renderBudget();
  if (page === 'payment')   renderPayments();
  if (page === 'procurement') renderProcurement();
  if (page === 'activity')  renderGantt();
  if (page === 'yearend')   renderYearEnd();
  if (page === 'notifications') renderNotifications();
  if (page === 'settings')  renderSettings();
  if (page === 'transfer')  renderTransfers();
}

function renderDashboard() {
  // Quick approvals
  const list = document.getElementById('approval-quick-list');
  if (!list) return;
  list.innerHTML = DB.approvals.slice(0,4).map(a => `
    <div style="padding:12px 16px;border-bottom:1px solid rgba(42,58,85,.3);display:flex;align-items:center;gap:12px;cursor:pointer;" onclick="openApproveModal('${a.id}')">
      <div style="width:36px;height:36px;border-radius:8px;background:${a.urgency==='high'?'rgba(239,68,68,.15)':a.urgency==='medium'?'rgba(245,158,11,.15)':'rgba(59,130,246,.15)'};display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">
        ${a.type==='payment'?'🧾':a.type==='transfer'?'🔄':a.type==='retroactive'?'⏪':'📋'}
      </div>
      <div style="flex:1;min-width:0;">
        <div style="font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${a.title}</div>
        <div style="font-size:12px;color:var(--text3);">${a.requestedBy} · ${a.dept}</div>
      </div>
      <div style="text-align:right;flex-shrink:0;">
        <div style="font-size:13px;font-weight:700;color:var(--accent3);">${a.amount.toLocaleString()}</div>
        <div style="font-size:11px;color:${a.urgency==='high'?'var(--danger)':'var(--text3)'};">${a.urgency==='high'?'🔴 ด่วน':a.urgency==='medium'?'🟡 ปกติ':'🟢 ต่ำ'}</div>
      </div>
    </div>
  `).join('');

  // Dept budget bars
  const bars = document.getElementById('dept-budget-bars');
  if (!bars) return;
  const depts = [
    {name:'วิชาการ', approved:750000, spent:450000},
    {name:'กิจการนักเรียน', approved:400000, spent:320000},
    {name:'บุคคล', approved:200000, spent:180000},
    {name:'งบประมาณ', approved:150000, spent:90000},
    {name:'ทั่วไป', approved:300000, spent:160000},
  ];
  bars.innerHTML = depts.map(d => {
    const pct = Math.round((d.spent/d.approved)*100);
    const color = pct>90?'progress-danger':pct>70?'progress-amber':'progress-green';
    return `
      <div class="budget-item">
        <div class="budget-labels">
          <span class="budget-name">${d.name}</span>
          <span class="budget-numbers">${d.spent.toLocaleString()} / ${d.approved.toLocaleString()} บาท <strong style="color:${pct>90?'var(--danger)':'var(--text)'};">(${pct}%)</strong></span>
        </div>
        <div class="budget-bar-wrap"><div class="budget-fill ${color}" style="width:${pct}%"></div></div>
      </div>
    `;
  }).join('');

  // Project table
  const tbody = document.getElementById('dashboard-project-table');
  if (!tbody) return;
  tbody.innerHTML = DB.projects.slice(0,5).map(p => `
    <tr>
      <td><span style="font-size:12px;font-family:monospace;color:var(--accent2);">${p.id}</span></td>
      <td><strong>${p.name}</strong><br><span style="font-size:12px;color:var(--text3);">${p.owner}</span></td>
      <td><span class="badge badge-draft">${p.dept}</span></td>
      <td style="font-weight:600;">${p.approved.toLocaleString()}</td>
      <td>
        <div style="width:80px;">
          <div class="progress"><div class="progress-bar progress-blue" style="width:${p.progress}%"></div></div>
          <div style="font-size:11px;color:var(--text3);text-align:center;margin-top:2px;">${p.progress}%</div>
        </div>
      </td>
      <td>${statusBadge(p.status)}</td>
      <td>
        <button class="btn btn-secondary btn-xs" onclick="showProjectDetail('${p.id}')">👁 ดู</button>
      </td>
    </tr>
  `).join('');
}

function renderProjects(filter='', statusFilter='') {
  const tbody = document.getElementById('projects-table');
  if (!tbody) return;
  let data = DB.projects;
  if (filter) data = data.filter(p => p.name.includes(filter) || p.id.includes(filter));
  if (statusFilter) data = data.filter(p => p.status === statusFilter);

  tbody.innerHTML = data.map(p => {
    const pct = Math.round((p.spent/p.approved)*100) || 0;
    const remaining = p.approved - p.spent;
    return `
      <tr>
        <td><span style="font-size:12px;font-family:monospace;color:var(--accent2);">${p.id}</span></td>
        <td>
          <strong style="cursor:pointer;color:var(--accent);" onclick="showProjectDetail('${p.id}')">${p.name}</strong>
          <br><span style="font-size:12px;color:var(--text3);">${p.owner} · ${p.source}</span>
        </td>
        <td><span class="badge badge-draft">${p.dept}</span></td>
        <td style="font-weight:600;">${p.approved.toLocaleString()}</td>
        <td style="color:var(--accent3);">${p.spent.toLocaleString()}</td>
        <td style="color:${remaining<p.approved*0.2?'var(--danger)':'var(--accent4)'};">${remaining.toLocaleString()}</td>
        <td>
          <div style="width:80px;">
            <div class="progress"><div class="progress-bar ${pct>90?'progress-green':pct>60?'progress-blue':'progress-amber'}" style="width:${p.progress}%"></div></div>
            <div style="font-size:11px;text-align:center;margin-top:2px;">${p.progress}%</div>
          </div>
        </td>
        <td>${statusBadge(p.status)}</td>
        <td>
          <div style="display:flex;gap:4px;">
            <button class="btn btn-secondary btn-xs" onclick="showProjectDetail('${p.id}')">👁</button>
            <button class="btn btn-secondary btn-xs">✏️</button>
            <button class="btn btn-secondary btn-xs" onclick="generateReport('D8')">📄</button>
          </div>
        </td>
      </tr>
    `;
  }).join('');
}

function renderApprovals() {
  const cont = document.getElementById('approval-content');
  if (!cont) return;
  cont.innerHTML = DB.approvals.map(a => {
    const pendingStep = a.chain.find(c => c.status === 'pending');
    const slaHours = Math.floor(Math.random()*60) + 1;
    const slaOver = slaHours > 48;
    return `
      <div class="card mb-16">
        <div class="card-header">
          <div>
            <div style="display:flex;align-items:center;gap:10px;">
              <span style="font-size:18px;">${a.type==='payment'?'🧾':a.type==='transfer'?'🔄':a.type==='retroactive'?'⏪':'📋'}</span>
              <div>
                <div style="font-size:15px;font-weight:700;">${a.title}</div>
                <div style="font-size:12px;color:var(--text3);">${a.id} · ${a.dept} · โดย ${a.requestedBy}</div>
              </div>
            </div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:18px;font-weight:800;color:var(--accent3);">${a.amount.toLocaleString()} ฿</div>
            <div style="font-size:12px;color:${slaOver?'var(--danger)':'var(--text3)'};">${slaOver?'🔴':'🕐'} SLA: ${slaHours}h ${slaOver?'(เกินกำหนด!)':'/48h'}</div>
          </div>
        </div>
        <div class="card-body" style="padding:12px 20px;">
          <div class="approval-chain">
            ${a.chain.map((step, i) => `
              <div class="chain-step">
                <div class="chain-dot ${step.status}">
                  ${step.status==='approved'?'✓':step.status==='rejected'?'✕':step.status==='pending'?'⏳':'○'}
                </div>
                <div class="chain-label">${step.role}<br><span style="color:var(--text2);font-size:10px;">${step.name}</span></div>
              </div>
              ${i < a.chain.length-1 ? `<div class="chain-line ${step.status==='approved'?'done':''}"></div>` : ''}
            `).join('')}
          </div>
          ${pendingStep ? `
            <div class="alert alert-warning" style="margin-top:8px;margin-bottom:0;">
              <span>⏳</span>
              <span>รอการอนุมัติจาก <strong>${pendingStep.name}</strong> (${pendingStep.role})</span>
            </div>
          ` : ''}
        </div>
        <div style="padding:12px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;">
          <button class="btn btn-secondary btn-sm" onclick="showProjectDetail('${a.projectId}')">👁 ดูรายละเอียด</button>
          <button class="btn btn-secondary btn-sm" onclick="doApprove('returned','${a.id}')">↩ คืนแก้ไข</button>
          <button class="btn btn-danger btn-sm" onclick="doApprove('rejected','${a.id}')">✕ ปฏิเสธ</button>
          <button class="btn btn-success btn-sm" onclick="doApprove('approved','${a.id}')">✅ อนุมัติ</button>
        </div>
      </div>
    `;
  }).join('');
}

function renderBudget() {
  // Category bars
  const bars = document.getElementById('budget-category-bars');
  if (bars) {
    const cats = [
      {name:'ค่าตอบแทน', total:450000, spent:280000},
      {name:'ค่าใช้สอย', total:600000, spent:380000},
      {name:'ค่าวัสดุ', total:500000, spent:420000},
      {name:'ค่าครุภัณฑ์', total:350000, spent:120000},
      {name:'ค่าที่ดิน/สิ่งก่อสร้าง', total:100000, spent:0},
    ];
    bars.innerHTML = cats.map(c => {
      const pct = Math.round((c.spent/c.total)*100);
      const color = pct>85?'progress-danger':pct>60?'progress-amber':'progress-green';
      return `
        <div class="budget-item">
          <div class="budget-labels">
            <span class="budget-name">${c.name}</span>
            <span class="budget-numbers">${c.spent.toLocaleString()} / ${c.total.toLocaleString()} (${pct}%)</span>
          </div>
          <div class="budget-bar-wrap"><div class="budget-fill ${color}" style="width:${pct}%"></div></div>
        </div>
      `;
    }).join('');
  }

  // Burn rate
  const chart = document.getElementById('burnrate-chart');
  if (chart) {
    const months = ['ต.ค.','พ.ย.','ธ.ค.','ม.ค.','ก.พ.','มี.ค.','เม.ย.'];
    const values = [85000, 120000, 180000, 200000, 160000, 140000, 95000];
    const max = Math.max(...values);
    chart.innerHTML = months.map((m,i) => {
      const h = Math.round((values[i]/max)*160);
      const isCurrentMonth = i === 3;
      return `
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;">
          <div style="font-size:11px;color:var(--text3);writing-mode:horizontal-tb;">${(values[i]/1000).toFixed(0)}k</div>
          <div style="width:100%;height:${h}px;border-radius:4px 4px 0 0;background:${isCurrentMonth?'var(--accent)':'var(--surface3)'};border:1px solid ${isCurrentMonth?'var(--accent)':'var(--border)'};transition:height .5s;cursor:pointer;" title="${m}: ${values[i].toLocaleString()} บาท"></div>
          <div style="font-size:11px;color:${isCurrentMonth?'var(--accent)':'var(--text3)'};">${m}</div>
        </div>
      `;
    }).join('');
  }

  // Budget project table
  const tbody = document.getElementById('budget-project-table');
  if (tbody) {
    tbody.innerHTML = DB.projects.map(p => {
      const pct = Math.round((p.spent/p.approved)*100) || 0;
      return `
        <tr>
          <td style="font-family:monospace;font-size:12px;color:var(--accent2);">${p.id}</td>
          <td><strong>${p.name}</strong></td>
          <td>${p.approved.toLocaleString()}</td>
          <td style="color:var(--accent3);">${p.spent.toLocaleString()}</td>
          <td style="color:${pct>90?'var(--danger)':'var(--accent4)'};">${(p.approved-p.spent).toLocaleString()}</td>
          <td>
            <div style="display:flex;align-items:center;gap:8px;">
              <div class="progress" style="width:60px;"><div class="progress-bar ${pct>85?'progress-danger':pct>60?'progress-amber':'progress-green'}" style="width:${pct}%"></div></div>
              <span style="font-size:12px;font-weight:600;">${pct}%</span>
            </div>
          </td>
          <td>${statusBadge(p.status)}</td>
        </tr>
      `;
    }).join('');
  }
}

function renderPayments() {
  const tbody = document.getElementById('payment-table');
  if (!tbody) return;
  const statusMap = {
    'pending_dept':'รอหัวหน้า', 'pending_procurement':'รอพัสดุ',
    'pending_finance':'รอการเงิน', 'pending_inspection':'รอตรวจรับ',
    'pending_payment':'รอสั่งจ่าย', 'paid':'จ่ายแล้ว'
  };
  tbody.innerHTML = DB.payments.map(pay => `
    <tr>
      <td style="font-family:monospace;font-size:12px;color:var(--accent2);">${pay.id}</td>
      <td style="font-size:13px;">${pay.projectId}</td>
      <td><strong>${pay.desc}</strong></td>
      <td style="font-weight:700;color:var(--accent3);">${pay.amount.toLocaleString()}</td>
      <td style="font-size:13px;">${pay.requestedBy}</td>
      <td style="font-size:12px;color:var(--text3);">${pay.date}</td>
      <td>${pay.status==='paid'?'<span class="badge badge-paid">💚 จ่ายแล้ว</span>':pay.status.includes('inspection')?'<span class="badge badge-review">🔍 รอตรวจรับ</span>':'<span class="badge badge-pending">⏳ '+statusMap[pay.status]+'</span>'}</td>
      <td>
        <div style="display:flex;gap:4px;">
          <button class="btn btn-secondary btn-xs">👁</button>
          ${pay.status!=='paid'?'<button class="btn btn-primary btn-xs" onclick="toast(\'ดำเนินการแล้ว\',\'success\')">▶</button>':''}
          <button class="btn btn-secondary btn-xs" onclick="toast(\'กำลังสร้าง PDF...\',\'info\')">📄</button>
        </div>
      </td>
    </tr>
  `).join('');
}

function renderProcurement() {
  const items = document.getElementById('proc-checklist-items');
  if (items) {
    const checks = [
      {ok:true, label:'สเปครายการถูกต้องตามที่โครงการกำหนด'},
      {ok:true, label:'ราคาไม่เกินราคากลางของทางราชการ'},
      {ok:true, label:'ใบเสนอราคาครบถ้วนและถูกต้อง'},
      {ok:true, label:'วิธีจัดหาถูกต้องตามระเบียบพัสดุ (ตกลงราคา < 500,000)'},
      {ok:true, label:'งบประมาณโครงการเพียงพอ (คงเหลือ 12,000 บาท)'},
      {ok:false, label:'ตรวจสอบการซื้อซ้ำ — พบรายการ "กระดาษ A4" เคยซื้อ 3 เดือนที่แล้ว', warn:true},
    ];
    items.innerHTML = checks.map(c => `
      <div class="checklist-item">
        <span class="check-icon ${c.ok && !c.warn?'check-pass':c.warn?'check-warn':'check-fail'}">${c.ok && !c.warn?'✅':c.warn?'⚠️':'❌'}</span>
        <span style="font-size:14px;color:${c.warn?'var(--accent3)':'var(--text)'};">${c.label}</span>
      </div>
    `).join('');
  }

  const assets = document.getElementById('assets-table');
  if (assets) {
    assets.innerHTML = DB.assets.map(a => `
      <tr>
        <td style="font-family:monospace;font-size:12px;color:var(--accent2);">${a.id}</td>
        <td><strong>${a.name}</strong></td>
        <td style="font-size:12px;color:var(--text3);">${a.serial}</td>
        <td style="font-weight:600;">${a.price.toLocaleString()}</td>
        <td style="font-size:13px;">${a.location}</td>
        <td style="font-size:12px;color:var(--text3);">${a.warranty}</td>
        <td><span class="badge badge-approved">✅ ${a.status}</span></td>
      </tr>
    `).join('');
  }
}

function renderGantt() {
  const cont = document.getElementById('gantt-container');
  if (!cont) return;
  const months = ['ต.ค.','พ.ย.','ธ.ค.','ม.ค.','ก.พ.','มี.ค.'];
  const tasks = [
    {name:'ค่ายวิชาการ', start:1, duration:3, color:'var(--accent)', progress:70},
    {name:'พัฒนาครู ICT', start:0, duration:3, color:'var(--accent4)', progress:100},
    {name:'กีฬาสี', start:1, duration:4, color:'var(--accent3)', progress:80},
    {name:'ห้องสมุดมีชีวิต', start:3, duration:3, color:'var(--accent2)', progress:0},
    {name:'อบรมผู้ปกครอง', start:1, duration:2, color:'var(--warning)', progress:55},
    {name:'นิทรรศการวิชาการ', start:3, duration:3, color:'var(--danger)', progress:35},
  ];
  const col = 100;
  cont.innerHTML = `
    <div class="gantt-wrap">
      <div class="gantt-header">
        <div style="width:160px;flex-shrink:0;padding:0 12px;font-size:12px;color:var(--text3);font-weight:600;">โครงการ</div>
        ${months.map(m => `<div class="gantt-month">${m}</div>`).join('')}
      </div>
      ${tasks.map(t => `
        <div class="gantt-row">
          <div class="gantt-label">${t.name}</div>
          <div class="gantt-track">
            <div class="gantt-bar"
              style="left:${t.start*col/6*100}%;width:${t.duration*col/6*100}%;background:${t.color};opacity:.85;"
              title="${t.name}: ${t.progress}%">
              ${t.progress}%
            </div>
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderYearEnd() {
  const steps = document.getElementById('yearend-steps');
  if (!steps) return;
  const list = [
    {label:'หยุดเสนอโครงการใหม่', done:true, date:'1 ก.ย. 2568'},
    {label:'รวบรวมงบคงเหลือทุกโครงการ', done:true, date:'5 ก.ย. 2568'},
    {label:'ดำเนินการ Carry-Over โครงการข้ามปี', done:false, date:'10 ก.ย. 2568'},
    {label:'สร้างรายงานสรุปประจำปี', done:false, date:'20 ก.ย. 2568'},
    {label:'Archive โครงการที่เสร็จสิ้น', done:false, date:'25 ก.ย. 2568'},
    {label:'เปิดปีงบประมาณใหม่ 2569', done:false, date:'1 ต.ค. 2568'},
  ];
  steps.innerHTML = `<div class="timeline">` + list.map((s,i) => `
    <div class="timeline-item ${s.done?'done':i===2?'active':''}">
      <div class="timeline-date">${s.date}</div>
      <div class="timeline-title" style="color:${s.done?'var(--accent4)':i===2?'var(--accent)':'var(--text)'};">${s.done?'✅':i===2?'⏳':'○'} ${s.label}</div>
      ${i===2?'<div class="timeline-body"><button class="btn btn-primary btn-sm" style="margin-top:8px;" onclick="toast(\'กำลังดำเนินการ...\',\'info\')">▶ ดำเนินการ</button></div>':''}
    </div>
  `).join('') + `</div>`;
}

function renderNotifications() {
  const list = document.getElementById('notifications-list');
  if (!list) return;
  list.innerHTML = DB.notifications.map(n => `
    <div style="background:${n.read?'var(--surface)':'var(--surface2)'};border:1px solid ${n.read?'var(--border)':n.urgent?'rgba(239,68,68,.3)':'rgba(59,130,246,.3)'};border-radius:var(--radius);padding:14px 16px;margin-bottom:10px;display:flex;align-items:flex-start;gap:14px;cursor:pointer;" onclick="markRead(${n.id})">
      <div style="font-size:24px;flex-shrink:0;">${n.icon}</div>
      <div style="flex:1;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
          <div style="font-size:14px;font-weight:${n.read?'500':'700'};color:${n.urgent?'var(--danger)':'var(--text)'};">${n.title}${n.urgent?'<span style="font-size:11px;background:var(--danger);color:#fff;padding:1px 6px;border-radius:4px;margin-left:8px;">ด่วน</span>':''}</div>
          <div style="font-size:12px;color:var(--text3);flex-shrink:0;margin-left:12px;">${n.time}</div>
        </div>
        <div style="font-size:13px;color:var(--text2);margin-top:4px;">${n.body}</div>
      </div>
      ${!n.read?'<div style="width:8px;height:8px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:4px;"></div>':''}
    </div>
  `).join('');
}

function renderSettings() {
  const tbody = document.getElementById('users-table');
  if (!tbody) return;
  const roleColors = {DIRECTOR:'var(--danger)', DEPUTY:'var(--accent3)', DEPT_HEAD:'var(--accent2)', TEACHER:'var(--accent)', PROCUREMENT:'var(--accent4)', FINANCE:'var(--accent4)'};
  tbody.innerHTML = DB.users.map(u => `
    <tr>
      <td><strong>${u.name}</strong></td>
      <td style="font-size:13px;color:var(--text3);">${u.email}</td>
      <td><span class="badge" style="background:rgba(59,130,246,.1);color:${roleColors[u.role]||'var(--text)'};">${u.role}</span></td>
      <td><span class="badge badge-approved">● ${u.status}</span></td>
      <td><button class="btn btn-secondary btn-xs">✏️ แก้ไข</button></td>
    </tr>
  `).join('');
}

function renderTransfers() {
  const tbody = document.getElementById('transfer-history-table');
  if (!tbody) return;
  tbody.innerHTML = DB.transfers.map(t => `
    <tr>
      <td style="font-family:monospace;font-size:12px;color:var(--accent2);">${t.id}</td>
      <td style="font-size:13px;">${t.from}</td>
      <td style="font-size:13px;">${t.to}</td>
      <td style="font-weight:700;color:var(--accent3);">${t.amount.toLocaleString()}</td>
      <td style="font-size:13px;color:var(--text2);">${t.reason}</td>
      <td>${t.status==='approved'?'<span class="badge badge-approved">✅ อนุมัติแล้ว</span>':'<span class="badge badge-pending">⏳ รออนุมัติ</span>'}</td>
      <td style="font-size:12px;color:var(--text3);">${t.date}</td>
    </tr>
  `).join('');
}

// ===== PROJECT DETAIL =====
function showProjectDetail(id) {
  const p = DB.projects.find(x => x.id === id);
  if (!p) return;
  const pct = Math.round((p.spent/p.approved)*100) || 0;
  const remaining = p.approved - p.spent;
  document.getElementById('detail-title').textContent = `📋 ${p.id} — ${p.name}`;
  document.getElementById('modal-detail-body').innerHTML = `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
      <div>
        <div style="display:grid;gap:10px;">
          <div class="kpi-card"><div class="kpi-target">งบอนุมัติ</div><div class="kpi-actual" style="color:var(--accent);">${p.approved.toLocaleString()}</div><div class="kpi-unit">บาท</div></div>
          <div class="kpi-card"><div class="kpi-target">เบิกจ่ายแล้ว</div><div class="kpi-actual" style="color:var(--accent3);">${p.spent.toLocaleString()}</div><div class="kpi-unit">บาท (${pct}%)</div></div>
          <div class="kpi-card"><div class="kpi-target">คงเหลือ</div><div class="kpi-actual" style="color:${remaining<p.approved*0.2?'var(--danger)':'var(--accent4)'};">${remaining.toLocaleString()}</div><div class="kpi-unit">บาท</div></div>
        </div>
      </div>
      <div>
        <div class="form-group" style="margin-bottom:12px;"><div style="font-size:12px;color:var(--text3);">ฝ่าย</div><div style="font-weight:600;">${p.dept}</div></div>
        <div class="form-group" style="margin-bottom:12px;"><div style="font-size:12px;color:var(--text3);">ผู้รับผิดชอบ</div><div style="font-weight:600;">${p.owner}</div></div>
        <div class="form-group" style="margin-bottom:12px;"><div style="font-size:12px;color:var(--text3);">ระยะเวลา</div><div style="font-weight:600;">${p.start} ถึง ${p.end}</div></div>
        <div class="form-group"><div style="font-size:12px;color:var(--text3);">สถานะ</div>${statusBadge(p.status)}</div>
      </div>
    </div>
    <div style="margin-bottom:16px;">
      <div style="font-size:13px;color:var(--text3);margin-bottom:6px;">ความก้าวหน้าโครงการ</div>
      <div class="progress" style="height:16px;"><div class="progress-bar progress-blue" style="width:${p.progress}%"></div></div>
      <div style="text-align:right;font-size:13px;font-weight:700;color:var(--accent);margin-top:4px;">${p.progress}%</div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button class="btn btn-primary btn-sm" onclick="closeModal('modal-project-detail');goto('payment');toast('เปิดหน้าขอเบิก','info')">🧾 ขอเบิกเงิน</button>
      <button class="btn btn-secondary btn-sm" onclick="closeModal('modal-project-detail');goto('amendment')">📝 ขอเปลี่ยนแปลง</button>
      <button class="btn btn-secondary btn-sm" onclick="generateReport('D1')">📄 สร้างรายงาน</button>
    </div>
  `;
  openModal('modal-project-detail');
}

// ===== APPROVAL =====
function openApproveModal(id) {
  const a = DB.approvals.find(x => x.id === id);
  if (!a) return;
  document.getElementById('modal-approve-title').textContent = `${a.id} — ${a.title}`;
  document.getElementById('modal-approve-chain').innerHTML = a.chain.map((step, i) => `
    <div class="chain-step">
      <div class="chain-dot ${step.status}">${step.status==='approved'?'✓':step.status==='pending'?'⏳':'○'}</div>
      <div class="chain-label">${step.role}<br><span style="font-size:10px;color:var(--text2);">${step.name}</span></div>
    </div>
    ${i < a.chain.length-1 ? `<div class="chain-line ${step.status==='approved'?'done':''}"></div>` : ''}
  `).join('');
  openModal('modal-approve');
}

function doApprove(action, id) {
  const msgs = { approved:'✅ อนุมัติเรียบร้อย', rejected:'❌ ปฏิเสธแล้ว', returned:'↩ คืนให้แก้ไขแล้ว', conditional:'⚠️ อนุมัติแบบมีเงื่อนไข' };
  const types = { approved:'success', rejected:'error', returned:'warning', conditional:'warning' };
  closeModal('modal-approve');
  toast(msgs[action] || action, types[action] || 'info');

  if (id) {
    const idx = DB.approvals.findIndex(a => a.id === id);
    if (idx >= 0 && action === 'approved') {
      DB.approvals.splice(idx, 1);
      setTimeout(() => renderApprovals(), 300);
    }
  }
}

// ===== FORM FUNCTIONS =====
function calcTotal() {
  const vals = ['pj-c1','pj-c2','pj-c3','pj-c4'].map(id => parseInt(document.getElementById(id)?.value)||0);
  const total = vals.reduce((a,b) => a+b, 0);
  const el = document.getElementById('pj-total');
  if (el) el.textContent = total.toLocaleString() + ' บาท';
}

function calcPriority(el, key) {
  priorityScores[key] = parseInt(el.value);
  document.getElementById(key+'-val').textContent = el.value;
  const score = priorityScores.urgency * priorityScores.impact * priorityScores.strategic;
  document.getElementById('priority-score').textContent = score;
}

function submitProject() {
  const name = document.getElementById('pj-name')?.value;
  if (!name || name.trim() === '') {
    toast('กรุณากรอกชื่อโครงการ', 'error');
    return;
  }
  const newId = 'PRJ-2568-0' + (DB.projects.length + 1).toString().padStart(2,'0');
  const dept = document.getElementById('pj-dept')?.value || 'ทั่วไป';
  const source = document.getElementById('pj-source')?.value || 'งบรัฐบาล';
  const start = document.getElementById('pj-start')?.value || '2025-01-01';
  const end = document.getElementById('pj-end')?.value || '2025-03-31';
  const c1 = parseInt(document.getElementById('pj-c1')?.value)||0;
  const c2 = parseInt(document.getElementById('pj-c2')?.value)||0;
  const c3 = parseInt(document.getElementById('pj-c3')?.value)||0;
  const c4 = parseInt(document.getElementById('pj-c4')?.value)||0;
  const total = c1+c2+c3+c4;
  DB.projects.push({id:newId, name, dept, owner:'ผู้ใช้ปัจจุบัน', approved:total, spent:0, status:'submitted', progress:0, start, end, source});
  DB.approvals.push({id:'APV-2568-0'+(DB.approvals.length+1).toString().padStart(2,'0'), projectId:newId, title:name, amount:total, dept, requestedBy:'ผู้ใช้ปัจจุบัน', type:'project', urgency:'medium', chain:[{level:1,role:'หัวหน้าฝ่าย',status:'pending',name:'หัวหน้า'+dept}]});
  closeModal('modal-new-project');
  toast('✅ ส่งเสนอโครงการ ' + newId + ' เรียบร้อยแล้ว', 'success');
  setTimeout(() => { renderProjects(); renderDashboard(); }, 300);
}

function saveProjectDraft() {
  toast('💾 บันทึกร่างแล้ว (Auto-save ทุก 30 วินาที)', 'info');
}

function submitPayment() {
  closeModal('modal-new-payment');
  toast('📤 ยื่นคำขอเบิกเงินเรียบร้อย รอการอนุมัติ', 'success');
}

function submitTransfer() {
  toast('📤 ส่งขออนุมัติโยกงบเรียบร้อย', 'success');
}

function submitAmendment() {
  toast('📤 ส่งขอเปลี่ยนแปลงงบเรียบร้อย รอการอนุมัติ', 'success');
}

function generateReport(doc) {
  const names = {D1:'บันทึกข้อความเสนอโครงการ',D2:'คำสั่งแต่งตั้งคณะกรรมการ',D3:'คำสั่งกรรมการตรวจรับ',D4:'ใบขอซื้อ/ขอจ้าง',D5:'ใบสั่งซื้อ/สั่งจ้าง',D6:'ใบตรวจรับพัสดุ',D7:'ใบสำคัญจ่าย',D8:'รายงานผลโครงการ',D9:'บันทึกขอเปลี่ยนแปลง'};
  toast('📄 กำลังสร้าง ' + (names[doc]||doc) + '... (ระบบจริงจะเชื่อม Google Drive)', 'info');
}

function filterProjects(val) { renderProjects(val); }
function filterByStatus(val) { renderProjects('', val); }

function markRead(id) {
  const n = DB.notifications.find(x => x.id === id);
  if (n) { n.read = true; renderNotifications(); }
}

function markAllRead() {
  DB.notifications.forEach(n => n.read = true);
  renderNotifications();
  toast('อ่านทั้งหมดแล้ว', 'success');
}

function calcPaymentTotal() {
  let total = 0;
  document.querySelectorAll('#payment-items tr').forEach((row, i) => {
    const inputs = row.querySelectorAll('input[type=number]');
    if (inputs.length >= 2) {
      const q = parseFloat(inputs[0].value)||0;
      const p = parseFloat(inputs[1].value)||0;
      const r = q*p;
      total += r;
      const cell = document.getElementById('pay-row-' + i);
      if (cell) cell.textContent = r.toLocaleString();
    }
  });
  const el = document.getElementById('pay-grand-total');
  if (el) el.textContent = total.toLocaleString() + ' บาท';
  // Auto-detect procurement method
  const hint = document.getElementById('proc-method-hint');
  if (hint) {
    if (total < 500000) hint.innerHTML = '✅ <strong>ตกลงราคา</strong> (< 500,000 บาท) — จัดซื้อโดยตรงได้';
    else if (total < 2000000) hint.innerHTML = '⚠️ <strong>สอบราคา</strong> (500,000–2,000,000 บาท) — ต้องมีใบเสนอราคา 3 ราย';
    else hint.innerHTML = '🚨 <strong>ประกวดราคา e-GP</strong> (≥ 2,000,000 บาท) — ต้องประกวดราคาผ่านระบบ';
  }
}

// ===== MODAL =====
function openModal(id) {
  const m = document.getElementById(id);
  if (m) {
    m.classList.add('active');
    m.addEventListener('click', function(e) { if (e.target === m) closeModal(id); }, {once:true});
  }
}

function closeModal(id) {
  const m = document.getElementById(id);
  if (m) m.classList.remove('active');
}

// ===== TOAST =====
function toast(msg, type='info') {
  const icons = {success:'✅', error:'❌', warning:'⚠️', info:'ℹ️'};
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.innerHTML = `<span class="toast-icon">${icons[type]||'ℹ️'}</span><span class="toast-msg">${msg}</span>`;
  document.getElementById('toast-container').appendChild(el);
  setTimeout(() => el.remove(), 4000);
}

// ===== HELPERS =====
function statusBadge(status) {
  const map = {
    draft:'<span class="badge badge-draft">📝 ร่าง</span>',
    submitted:'<span class="badge badge-submitted">📤 ส่งแล้ว</span>',
    under_review:'<span class="badge badge-review">🔍 กลั่นกรอง</span>',
    approved:'<span class="badge badge-approved">✅ อนุมัติ</span>',
    approved_conditional:'<span class="badge badge-approved_cond">⚠️ มีเงื่อนไข</span>',
    in_progress:'<span class="badge badge-progress">🔄 กำลังดำเนิน</span>',
    suspended:'<span class="badge badge-suspended">⏸️ ระงับ</span>',
    completed:'<span class="badge badge-completed">✅ เสร็จสิ้น</span>',
    cancelled:'<span class="badge badge-cancelled">❌ ยกเลิก</span>',
  };
  return map[status] || `<span class="badge badge-draft">${status}</span>`;
}

// Auto-save draft (simulated)
let autoSaveTimer;
function setupAutoSave() {
  const modal = document.getElementById('modal-new-project');
  if (modal) {
    modal.querySelectorAll('input, textarea, select').forEach(el => {
      el.addEventListener('input', () => {
        clearTimeout(autoSaveTimer);
        autoSaveTimer = setTimeout(() => {
          const indicator = document.createElement('div');
          indicator.style.cssText = 'position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:6px 14px;font-size:12px;color:var(--text3);z-index:9999;';
          indicator.textContent = '💾 บันทึกร่างอัตโนมัติ...';
          document.body.appendChild(indicator);
          setTimeout(() => indicator.remove(), 2000);
        }, 30000);
      });
    });
  }
}

// ===== KEYBOARD SHORTCUTS =====
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
  }
});

// ===== INIT =====
window.addEventListener('DOMContentLoaded', () => {
  renderDashboard();
  setupAutoSave();

  // Responsive sidebar
  const menuBtn = document.getElementById('menu-btn');
  if (window.innerWidth <= 768 && menuBtn) menuBtn.style.display = 'flex';

  // Welcome toast
  setTimeout(() => {
    toast('🎉 ยินดีต้อนรับสู่ SPBMS โรงเรียนเมืองคง | ปีงบประมาณ 2568', 'info');
  }, 800);

  setTimeout(() => {
    toast('⚠️ มี 5 รายการรออนุมัติ และ 1 SLA เกินกำหนด', 'warning');
  }, 2500);
});
</script>
</body>
</html>
