    { id:4, type:'payment_ready', icon:'💰', title:'พร้อมสั่งจ่าย', body:'PAY-2568-003 — ตรวจรับเรียบร้อย รอการเงินสั่งจ่าย 36,000 บาท', time:'3 ชั่วโมงที่แล้ว', read:false, urgent:false },
    { id:5, type:'approved', icon:'🎉', title:'อนุมัติโครงการแล้ว', body:'PRJ-2568-004 — พัฒนาห้องสมุดมีชีวิต ได้รับอนุมัติงบ 55,000 บาท', time:'เมื่อวาน', read:true, urgent:false },
    { id:6, type:'sla_breach', icon:'🚨', title:'SLA เกินกำหนด!', body:'APV-2568-002 — รออนุมัติมาแล้ว 72 ชั่วโมง (เกิน SLA 48h)', time:'เมื่อวาน', read:true, urgent:true },
