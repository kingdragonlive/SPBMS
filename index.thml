      <!-- ========== PAGE: ACTIVITY ========== -->
      <div class="page" id="page-activity">
        <div class="card mb-24">
          <div class="card-header">
            <h3>📅 Gantt Chart — แผนกิจกรรม 2568</h3>
            <select class="form-control" style="width:auto;">
              <option>ทุกโครงการ</option>
              <option>PRJ-2568-001</option>
              <option>PRJ-2568-002</option>
            </select>
          </div>
          <div class="card-body" id="gantt-container">
            <!-- Gantt rendered by JS -->
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3>⚠️ Resource Conflict Alert</h3>
          </div>
          <div class="card-body">
            <div class="alert alert-warning">
              <span>⚠️</span>
              <div>
                <strong>ตรวจพบ Conflict!</strong> วันที่ 15 พ.ย. 2568 — ห้องประชุมใหญ่ถูกจองโดย 2 โครงการพร้อมกัน:
                PRJ-2568-001 (09:00-12:00) และ PRJ-2568-003 (10:00-14:00)
              </div>
            </div>
            <div class="alert alert-warning">
              <span>👤</span>
              <div>
                <strong>ครูซ้ำซ้อน!</strong> นางสาวรัตนา — อยู่ใน 3 โครงการวันที่ 18 พ.ย. 2568
              </div>
            </div>
          </div>
        </div>
      </div><!-- /activity -->

      <!-- ========== PAGE: PROCUREMENT ========== -->
      <div class="page" id="page-procurement">
        <div class="tab-bar">
          <div class="tab-item active" onclick="setTab('proc','checklist',this)">Checklist พัสดุ</div>
          <div class="tab-item" onclick="setTab('proc','inspect',this)">ตรวจรับพัสดุ</div>
          <div class="tab-item" onclick="setTab('proc','assets',this)">ทะเบียนพัสดุ</div>
          <div class="tab-item" onclick="setTab('proc','price',this)">ราคากลาง</div>
        </div>

        <div class="card mb-24">
          <div class="card-header">
            <h3>🛒 Checklist ตรวจสอบการจัดซื้อ</h3>
            <span class="badge badge-pending">PAY-2568-012</span>
          </div>
          <div class="card-body">
            <div id="proc-checklist-items"></div>
            <div class="divider"></div>
            <div style="display:flex;gap:10px;justify-content:flex-end;">
              <button class="btn btn-secondary">↩ คืนแก้ไข</button>
              <button class="btn btn-success" onclick="toast('อนุมัติการจัดซื้อเรียบร้อย','success')">✅ อนุมัติ</button>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h3>📦 ทะเบียนครุภัณฑ์</h3><button class="btn btn-primary btn-sm">+ ลงทะเบียน</button></div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>รหัสพัสดุ</th><th>ชื่อ</th><th>Serial No.</th><th>ราคา</th><th>สถานที่</th><th>ประกัน</th><th>สถานะ</th></tr>
              </thead>
              <tbody id="assets-table"></tbody>
            </table>
          </div>
        </div>
      </div><!-- /procurement -->

      <!-- ========== PAGE: AMENDMENT ========== -->
      <div class="page" id="page-amendment">
        <div class="tab-bar">
          <div class="tab-item active" onclick="setTab('amd','budget',this)">เปลี่ยนแปลงงบ</div>
          <div class="tab-item" onclick="setTab('amd','po',this)">เปลี่ยนรายการ PO</div>
          <div class="tab-item" onclick="setTab('amd','history',this)">ประวัติ</div>
        </div>

        <div class="card mb-24">
          <div class="card-header">
            <h3>📝 ขอเปลี่ยนแปลงงบประมาณ</h3>
            <div style="display:flex;gap:10px;align-items:center;">
              <span style="font-size:13px;color:var(--text3);">ครั้งที่ใช้ไปแล้ว:</span>
              <div style="display:flex;gap:4px;">
                <div style="width:16px;height:16px;border-radius:50%;background:var(--danger);"></div>
                <div style="width:16px;height:16px;border-radius:50%;background:var(--danger);"></div>
                <div style="width:16px;height:16px;border-radius:50%;background:var(--surface3);border:1px solid var(--border);"></div>
              </div>
              <span style="font-size:12px;color:var(--accent3);">เหลือ 1 ครั้ง</span>
            </div>
          </div>
          <div class="card-body">
            <div class="form-grid form-grid-2">
              <div class="form-group">
                <label>โครงการ <span class="required">*</span></label>
                <select class="form-control">
                  <option>PRJ-2568-001 — ค่ายวิชาการ</option>
                </select>
              </div>
              <div class="form-group">
                <label>ประเภทการเปลี่ยนแปลง</label>
                <select class="form-control">
                  <option>ปรับเปลี่ยนงบภายในโครงการ</option>
                  <option>ขอเพิ่มงบประมาณ</option>
                  <option>ลดงบประมาณ</option>
                </select>
              </div>
            </div>
            <div class="divider"></div>
            <!-- Diff View -->
            <h4 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--accent2);">📊 เปรียบเทียบ: งบเดิม vs งบใหม่ที่ขอ</h4>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
              <div>
                <div style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px;">
                  <div style="font-size:12px;font-weight:700;color:var(--text3);margin-bottom:8px;">งบเดิม</div>
                  <table style="width:100%;">
                    <tr><td style="padding:4px 0;font-size:13px;">ค่าตอบแทน</td><td style="text-align:right;font-size:13px;">10,000</td></tr>
                    <tr><td style="padding:4px 0;font-size:13px;">ค่าใช้สอย</td><td style="text-align:right;font-size:13px;">20,000</td></tr>
                    <tr><td style="padding:4px 0;font-size:13px;">ค่าวัสดุ</td><td style="text-align:right;font-size:13px;">15,000</td></tr>
                    <tr style="border-top:1px solid var(--border);"><td style="padding:8px 0 0;font-weight:700;">รวม</td><td style="text-align:right;font-weight:700;padding-top:8px;">45,000</td></tr>
                  </table>
                </div>
              </div>
              <div>
                <div style="background:rgba(16,185,129,.05);border:1px solid rgba(16,185,129,.3);border-radius:8px;padding:12px;">
                  <div style="font-size:12px;font-weight:700;color:var(--accent4);margin-bottom:8px;">งบใหม่ (ขอแก้ไข)</div>
                  <table style="width:100%;">
                    <tr><td style="padding:4px 0;font-size:13px;">ค่าตอบแทน</td><td style="text-align:right;"><input type="number" value="8000" class="form-control" style="width:80px;padding:4px 8px;font-size:13px;text-align:right;"></td></tr>
                    <tr><td style="padding:4px 0;font-size:13px;">ค่าใช้สอย</td><td style="text-align:right;"><input type="number" value="20000" class="form-control" style="width:80px;padding:4px 8px;font-size:13px;text-align:right;"></td></tr>
                    <tr><td style="padding:4px 0;font-size:13px;">ค่าวัสดุ</td><td style="text-align:right;"><input type="number" value="17000" class="form-control" style="width:80px;padding:4px 8px;font-size:13px;text-align:right;"></td></tr>
                    <tr style="border-top:1px solid rgba(16,185,129,.3);"><td style="padding:8px 0 0;font-weight:700;color:var(--accent4);">รวม</td><td style="text-align:right;font-weight:700;padding-top:8px;color:var(--accent4);">45,000</td></tr>
                  </table>
                </div>
              </div>
            </div>
            <div class="form-group" style="margin-top:16px;">
              <label>เหตุผลการเปลี่ยนแปลง <span class="required">*</span></label>
              <textarea class="form-control" placeholder="ระบุเหตุผลให้ชัดเจน...">ปรับตามราคาตลาดจริง ค่าตอบแทนลดลงเนื่องจากวิทยากรลดราคา ย้ายงบมาค่าวัสดุแทน</textarea>
            </div>
            <div style="text-align:right;margin-top:12px;">
              <button class="btn btn-primary" onclick="submitAmendment()">📤 ส่งขออนุมัติ</button>
            </div>
          </div>
        </div>
      </div><!-- /amendment -->

      <!-- ========== PAGE: REPORTS ========== -->
      <div class="page" id="page-reports">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;">
          <div class="card" style="cursor:pointer;" onclick="generateReport('D1')">
            <div class="card-body">
              <div style="font-size:32px;margin-bottom:12px;">📄</div>
              <h3 style="font-size:15px;margin-bottom:6px;">บันทึกข้อความเสนอโครงการ</h3>
              <p style="font-size:13px;color:var(--text3);">D1 — สร้าง PDF พร้อม QR Code</p>
              <button class="btn btn-primary btn-sm" style="margin-top:12px;">⬇️ สร้าง PDF</button>
            </div>
          </div>
          <div class="card" style="cursor:pointer;" onclick="generateReport('D2')">
            <div class="card-body">
              <div style="font-size:32px;margin-bottom:12px;">📋</div>
              <h3 style="font-size:15px;margin-bottom:6px;">คำสั่งแต่งตั้งคณะกรรมการ</h3>
              <p style="font-size:13px;color:var(--text3);">D2 — ออกอัตโนมัติหลังอนุมัติ</p>
              <button class="btn btn-primary btn-sm" style="margin-top:12px;">⬇️ สร้าง PDF</button>
            </div>
          </div>
          <div class="card" style="cursor:pointer;">
            <div class="card-body">
              <div style="font-size:32px;margin-bottom:12px;">🛒</div>
              <h3 style="font-size:15px;margin-bottom:6px;">ใบขอซื้อ/ใบขอจ้าง</h3>
              <p style="font-size:13px;color:var(--text3);">D4 — สร้างจาก Payment Request</p>
              <button class="btn btn-primary btn-sm" style="margin-top:12px;">⬇️ สร้าง PDF</button>
            </div>
          </div>
          <div class="card" style="cursor:pointer;">
            <div class="card-body">
              <div style="font-size:32px;margin-bottom:12px;">✅</div>
              <h3 style="font-size:15px;margin-bottom:6px;">ใบตรวจรับพัสดุ</h3>
              <p style="font-size:13px;color:var(--text3);">D6 — ลายเซ็น 3 กรรมการ</p>
              <button class="btn btn-primary btn-sm" style="margin-top:12px;">⬇️ สร้าง PDF</button>
            </div>
          </div>
          <div class="card" style="cursor:pointer;">
            <div class="card-body">
              <div style="font-size:32px;margin-bottom:12px;">💰</div>
              <h3 style="font-size:15px;margin-bottom:6px;">ใบสำคัญจ่าย</h3>
              <p style="font-size:13px;color:var(--text3);">D7 — การเงินสั่งจ่าย</p>
              <button class="btn btn-primary btn-sm" style="margin-top:12px;">⬇️ สร้าง PDF</button>
            </div>
          </div>
          <div class="card" style="cursor:pointer;">
            <div class="card-body">
              <div style="font-size:32px;margin-bottom:12px;">📊</div>
              <h3 style="font-size:15px;margin-bottom:6px;">แผนปฏิบัติการประจำปี</h3>
              <p style="font-size:13px;color:var(--text3);">Excel — ทุกโครงการ</p>
              <button class="btn btn-warning btn-sm" style="margin-top:12px;">⬇️ Excel</button>
            </div>
          </div>
          <div class="card" style="cursor:pointer;">
            <div class="card-body">
              <div style="font-size:32px;margin-bottom:12px;">📈</div>
              <h3 style="font-size:15px;margin-bottom:6px;">รายงานงบประมาณรายเดือน</h3>
              <p style="font-size:13px;color:var(--text3);">Excel — รายโครงการ</p>
              <button class="btn btn-warning btn-sm" style="margin-top:12px;">⬇️ Excel</button>
            </div>
          </div>
          <div class="card" style="cursor:pointer;">
            <div class="card-body">
              <div style="font-size:32px;margin-bottom:12px;">🎓</div>
              <h3 style="font-size:15px;margin-bottom:6px;">รายงาน SAR</h3>
              <p style="font-size:13px;color:var(--text3);">Word/PDF — ตามมาตรฐาน</p>
              <button class="btn btn-primary btn-sm" style="margin-top:12px;">⬇️ สร้าง PDF</button>
            </div>
          </div>
        </div>
      </div><!-- /reports -->

      <!-- ========== PAGE: YEAR END ========== -->
      <div class="page" id="page-yearend">
        <div class="alert alert-warning">
          <span>🔔</span>
          <span>เหลืออีก <strong>45 วัน</strong> ก่อนสิ้นปีงบประมาณ 30 กันยายน 2568 — กรุณาดำเนินการตาม Checklist</span>
        </div>

        <div class="card">
          <div class="card-header"><h3>📋 Year-End Closing Checklist</h3><span class="badge badge-progress">2/6 เสร็จ</span></div>
          <div class="card-body">
            <div id="yearend-steps"></div>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px;">
          <div class="card">
            <div class="card-header"><h3>🔄 โครงการ Carry-Over</h3></div>
            <div class="card-body">
              <div class="alert alert-info"><span>ℹ️</span><span>โครงการที่ข้ามปีงบประมาณ (isDualYear=true)</span></div>
              <div style="font-size:14px;color:var(--text2);">ไม่มีโครงการ Carry-Over ในปีนี้</div>
            </div>
          </div>
          <div class="card">
            <div class="card-header"><h3>💰 งบคืนส่วนกลาง</h3></div>
            <div class="card-body">
              <div class="kpi-card" style="margin-bottom:12px;">
                <div class="kpi-target">คาดว่าจะคืน</div>
                <div class="kpi-actual" style="color:var(--accent3)">245,000</div>
                <div class="kpi-unit">บาท</div>
              </div>
              <div style="font-size:13px;color:var(--text3);">จาก 4 โครงการที่ยังมีงบเหลือ</div>
            </div>
          </div>
        </div>
      </div><!-- /yearend -->

      <!-- ========== PAGE: NOTIFICATIONS ========== -->
      <div class="page" id="page-notifications">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
          <h2 style="font-size:18px;font-weight:700;">🔔 ศูนย์แจ้งเตือน</h2>
          <button class="btn btn-secondary btn-sm" onclick="markAllRead()">✓ อ่านทั้งหมด</button>
        </div>
        <div id="notifications-list"></div>
      </div><!-- /notifications -->

      <!-- ========== PAGE: SETTINGS ========== -->
      <div class="page" id="page-settings">
        <div style="display:grid;grid-template-columns:1fr 2fr;gap:24px;">
          <div class="card">
            <div class="card-header"><h3>⚙️ เมนูตั้งค่า</h3></div>
            <div class="card-body" style="padding:8px;">
              <div class="nav-item" style="border-radius:8px;">👥 ผู้ใช้งานและสิทธิ์</div>
