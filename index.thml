              <div class="donut-container">
                <div class="donut">
                  <svg width="140" height="140" viewBox="0 0 140 140">
                    <!-- Background circle -->
                    <circle cx="70" cy="70" r="50" fill="none" stroke="var(--surface3)" stroke-width="20"/>
                    <!-- Spent: 60% = 188.5 of 314.16 -->
                    <circle cx="70" cy="70" r="50" fill="none" stroke="var(--accent4)" stroke-width="20"
                      stroke-dasharray="188.5 125.66" stroke-linecap="round"/>
                    <!-- Allocated but not spent: 20% -->
                    <circle cx="70" cy="70" r="50" fill="none" stroke="var(--accent)" stroke-width="20"
                      stroke-dasharray="62.83 251.33" stroke-dashoffset="-188.5" stroke-linecap="round"/>
                    <!-- Remaining: 20% -->
                    <circle cx="70" cy="70" r="50" fill="none" stroke="var(--border)" stroke-width="20"
                      stroke-dasharray="62.83 251.33" stroke-dashoffset="-251.33"/>
                  </svg>
                  <div class="donut-center">
                    <div class="donut-pct" style="color:var(--accent4)">60%</div>
                    <div class="donut-sub">เบิกจ่าย</div>
