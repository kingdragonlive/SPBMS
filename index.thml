            <div class="card-header"><h3>👥 จัดการผู้ใช้งาน</h3><button class="btn btn-primary btn-sm">+ เพิ่มผู้ใช้</button></div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>ชื่อ</th><th>อีเมล</th><th>บทบาท</th><th>สถานะ</th><th>จัดการ</th></tr>
                </thead>
                <tbody id="users-table"></tbody>
              </table>
